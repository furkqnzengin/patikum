# Patikum - Apache / cPanel yapılandırması
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS yönlendirmesi (SSL kurulduktan sonra aşağıdaki iki satırın başındaki # işaretini kaldırın)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Uygulama çekirdeğine ve gizli dosyalara doğrudan erişimi engelle
  RewriteRule ^app(/|$) - [F,L]
  RewriteRule (^|/)\.(git|env|htpasswd) - [F,L]
  RewriteRule \.(sql|md|sqlite|log)$ - [F,L]
</IfModule>

<FilesMatch "\.(sql|md|sqlite|log|ini)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
